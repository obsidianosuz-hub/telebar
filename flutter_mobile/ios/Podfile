platform :ios, '12.0'

# CocoaPods analytics sends usage stats. Change to false to opt-out.
install! 'cocoapods', :disable_input_output_paths => true

# Load flutter helper
def flutter_parent_directory
  File.expand_path('..', File.dirname(__FILE__))
end

plugin_pods_project_path = File.join(flutter_parent_directory(), '.flutter-plugins-dependencies')
if File.exist?(plugin_pods_project_path)
  # Loaded by Flutter automatically
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Flutter Pods
  flutter_install_all_ios_pods = File.join(flutter_parent_directory(), '.ios', 'Flutter', 'podhelper.rb')
  if File.exist?(flutter_install_all_ios_pods)
    require flutter_install_all_ios_pods
    flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  else
    # Fallback to local relative helper if loaded from parent
    podhelper_path = File.join(File.dirname(__FILE__), 'Flutter', 'podhelper.rb')
    if File.exist?(podhelper_path)
      require podhelper_path
      flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
    end
  end
end

post_install do |installer|
  # 1. Modify Pods Project
  installer.pods_project.targets.each do |target|
    if respond_to?(:flutter_additional_ios_build_settings)
      flutter_additional_ios_build_settings(target)
    end
    target.build_configurations.each do |config|
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings['DEVELOPMENT_TEAM'] = ''
    end
  end

  # 2. Modify Main Runner Project
  main_project_path = File.join(File.dirname(__FILE__), 'Runner.xcodeproj')
  if File.exist?(main_project_path)
    require 'xcodeproj'
    main_project = Xcodeproj::Project.open(main_project_path)
    main_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        config.build_settings['CODE_SIGN_IDENTITY'] = ''
        config.build_settings['DEVELOPMENT_TEAM'] = ''
      end
    end
    main_project.save
  end
end
